[global]
  monitor = 0
  follow = none
  origin = top-right
  offset = 10x10
  width = 300
  height = 100
  frame_width = 2
  separator_height = 2
  padding = 8

  horizontal_padding = 8
  font = Maple NF Normal 10
  format = "<b>%s</b>\n%b"

[urgency_low]
  timeout = 5
[urgency_normal]
  timeout = 8
[urgency_critical]
  timeout = 0
